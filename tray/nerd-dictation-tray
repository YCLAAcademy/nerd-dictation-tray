def running_dictation_pid():
    """Return the PID of a running nerd-dictation (from any launcher), otherwise None."""
    try:
        with open(COOKIE_FILE, encoding="utf-8") as fh:
            pid = int(fh.read())
        with open("/proc/{:d}/cmdline".format(pid), "rb") as fh:
            cmdline = fh.read()
    except (OSError, ValueError):
        return None
    if any(os.path.basename(arg) == b"nerd-dictation" for arg in cmdline.split(b"\0")):
        return pid
    return None


def find_vosk_python():
    # Prefer an interpreter that can `import vosk`.
    candidates = ["/usr/local/bin/python3", shutil.which("python3"), sys.executable]
    for exe in candidates:
        if not exe or not os.path.exists(exe):
            continue
        if subprocess.call([exe, "-c", "import vosk"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
            return exe
    return "python3"


def find_nerd_dictation():
    # In the parent checkout (this app lives in `tray/`), on PATH, or next to this app.
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = [
        os.path.join(os.path.dirname(here), "nerd-dictation"),
        shutil.which("nerd-dictation"),
        os.path.join(here, "nerd-dictation"),
        os.path.join(os.path.dirname(here), "nerd-dictation", "nerd-dictation"),
    ]
    for path in candidates:
        if path and os.path.isfile(path):
            return path
    return ""


