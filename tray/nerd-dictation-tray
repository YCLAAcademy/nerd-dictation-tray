        lbl = Gtk.Label(xalign=0)
        if markup:
            lbl.set_markup(text)
        else:
            lbl.set_text(text)
        if dim:
            lbl.get_style_context().add_class("dim-label")
        if wrap:
            lbl.set_line_wrap(True)
            lbl.set_max_width_chars(60)
        return lbl

