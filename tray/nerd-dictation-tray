    # ---- Sound widgets ----

    @staticmethod
    def _sound_chooser():
        chooser = Gtk.FileChooserButton(title="Choose a sound", action=Gtk.FileChooserAction.OPEN)
        sound_filter = Gtk.FileFilter()
        sound_filter.set_name("Sounds")
        for pattern in ("*.oga", "*.ogg", "*.wav", "*.flac", "*.mp3"):
            sound_filter.add_pattern(pattern)
        chooser.add_filter(sound_filter)
        return chooser

    @staticmethod
    def _with_play_button(chooser):
        box = Gtk.Box(spacing=6)
        box.pack_start(chooser, True, True, 0)
        play = Gtk.Button.new_from_icon_name("media-playback-start-symbolic", Gtk.IconSize.BUTTON)
        play.set_tooltip_text("Preview")
        play.connect("clicked", lambda _b: play_sound(chooser.get_filename()))
        box.pack_start(play, False, False, 0)
        return box

    # ---- Values ----

    @staticmethod
    def _set_file(chooser, path, fallback_dir):
        chooser.unselect_all()
        if path and os.path.exists(path):
            chooser.set_filename(path)
        else:
            chooser.set_current_folder(fallback_dir)

    def load(self, cfg):
        """Fill the form from a config (the saved one, or DEFAULT_CONFIG for a reset)."""
        self.begin_btn.accel = cfg["shortcut_begin"]
        self.begin_btn.set_label(accel_label(cfg["shortcut_begin"]))
        self.end_btn.accel = cfg["shortcut_end"]
        self.end_btn.set_label(accel_label(cfg["shortcut_end"]))
        self._set_file(self.script_chooser, cfg["nerd_dictation"], os.path.expanduser("~"))
        self._set_file(self.model_chooser, cfg["model_dir"], CONFIG_DIR)
        self.input_combo.set_active_id(cfg["input"])
        self.noise_check.set_active(cfg["noise_suppression"])
        self.level_scale.set_value(cfg["mic_level"])
        self.ignore_check.set_active(cfg["ignore_words_enabled"])
        self.ignore_entry.set_text(cfg["ignore_words"])
        self.whisper_check.set_active(cfg["whisper_enabled"])
        self.whisper_model_combo.get_child().set_text(cfg["whisper_model"])
        self.whisper_device_combo.set_active_id(cfg["whisper_device"])
        self.whisper_language_combo.set_active_id(cfg["whisper_language"])
        self.whisper_pause_scale.set_value(cfg["whisper_pause"])
        self.sounds_check.set_active(cfg["sounds"])
        self._set_file(self.sound_begin_chooser, cfg["sound_begin"], "/usr/share/sounds")
        self._set_file(self.sound_end_chooser, cfg["sound_end"], "/usr/share/sounds")

    def collect(self):
        return {
            "nerd_dictation": self.script_chooser.get_filename() or self.app.config["nerd_dictation"],
            "shortcut_begin": self.begin_btn.accel,
            "shortcut_end": self.end_btn.accel,
            "model_dir": self.model_chooser.get_filename() or "",
            "input": self.input_combo.get_active_id() or "PAREC",
            "noise_suppression": self.noise_check.get_active(),
            "mic_level": int(self.level_scale.get_value()),
            "ignore_words_enabled": self.ignore_check.get_active(),
            "ignore_words": self.ignore_entry.get_text().strip(),
            "whisper_enabled": self.whisper_check.get_active(),
            "whisper_model": self.whisper_model_combo.get_child().get_text().strip() or "large-v3-turbo",
            "whisper_device": self.whisper_device_combo.get_active_id() or "auto",
            "whisper_language": self.whisper_language_combo.get_active_id() or "",
            "whisper_pause": round(self.whisper_pause_scale.get_value(), 1),
            "sounds": self.sounds_check.get_active(),
            "sound_begin": self.sound_begin_chooser.get_filename() or "",
            "sound_end": self.sound_end_chooser.get_filename() or "",
        }


class TrayApp:
    def __init__(self):
        self.config = load_config()
        self.python = find_vosk_python()
        self.proc = None
        self.proc_engine = ""  # "Whisper" or "VOSK", the engine our dictation was started with.
        self.ready = False  # Our process has loaded its model and is listening.
        self._stderr_buf = b""
        self._stderr_tail = []
        self._last_running = False
        self.bound = []
        self.settings_dialog = None

        self.menu = Gtk.Menu()
        self.item_start = Gtk.MenuItem(label="Start dictation")
        self.item_start.connect("activate", lambda _w: self.begin())
        self.item_stop = Gtk.MenuItem(label="Stop dictation")
        self.item_stop.connect("activate", lambda _w: self.end())
        # Quick switch between the speech engines, also in Settings ("Speech engine" tab).
        self.item_whisper = Gtk.RadioMenuItem(label="Engine: Whisper")
        self.item_vosk = Gtk.RadioMenuItem.new_with_label_from_widget(self.item_whisper, "Engine: VOSK")
        self._sync_engine_items()
        self.item_whisper.connect("toggled", self._on_engine_toggled)
        item_settings = Gtk.MenuItem(label="Settings…")
        item_settings.connect("activate", lambda _w: self.open_settings())
        item_exit = Gtk.MenuItem(label="Exit")
        item_exit.connect("activate", lambda _w: self.quit())
        for item in (self.item_start, self.item_stop, Gtk.SeparatorMenuItem(),
                     self.item_whisper, self.item_vosk, Gtk.SeparatorMenuItem(), item_settings, item_exit):
            self.menu.append(item)
        self.menu.show_all()

        self._create_icon()
        Keybinder.init()
        self.bind_shortcuts()
        self.update_state()
        GLib.timeout_add_seconds(1, self._poll)

    # ---- Tray icon ----

    def _create_icon(self):
        if XApp is not None:
            # Native Cinnamon/MATE/Xfce status icon: right-click menu, left-click toggles.
            self.icon = XApp.StatusIcon()
            self.icon.set_name(APP_NAME)
            self.icon.set_secondary_menu(self.menu)
            self.icon.connect("activate", self._on_left_click)
            self.kind = "xapp"
        else:
            self.icon = Gtk.StatusIcon()
            self.icon.connect("popup-menu", self._on_gtk_popup)
            self.icon.connect("activate", lambda _i: self.toggle())
            self.kind = "gtk"

    def _on_left_click(self, _icon, button, _time):
        if button == 1:
            self.toggle()

    def _on_gtk_popup(self, icon, button, time):
        self.menu.popup(None, None, Gtk.StatusIcon.position_menu, icon, button, time)

    def _set_icon(self, name, tooltip):
        if self.kind == "xapp":
            self.icon.set_icon_name(name)
            self.icon.set_tooltip_text(tooltip)
        else:
            if os.path.isabs(name):
                self.icon.set_from_file(name)
            else:
                self.icon.set_from_icon_name(name)
            self.icon.set_tooltip_text(tooltip)

    def update_state(self):
        running = self.is_running()
        if self._last_running and not running:
            # Played once the process has really finished (after typing the last words).
            self._play("sound_end")
        self._last_running = running
        self.item_start.set_sensitive(not running)
        self.item_stop.set_sensitive(running)
        own = self.proc is not None and self.proc.poll() is None
        if running and own and not self.ready:
            self._set_icon(ICON_IDLE, "Nerd Dictation: loading the speech model…")
        elif running:
            engine = " with " + self.proc_engine if own else ""
            self._set_icon(ICON_ACTIVE, "Nerd Dictation: listening{:s} ({:s} to stop)".format(
                engine, accel_label(self.config["shortcut_end"])))
        else:
            self._set_icon(ICON_IDLE, "Nerd Dictation: stopped ({:s} to start)".format(
                accel_label(self.config["shortcut_begin"])))

    # ---- Dictation control ----

    def is_running(self):
        if self.proc is not None and self.proc.poll() is None:
            return True
        # Also started elsewhere, e.g. from a terminal.
        return running_dictation_pid() is not None

    def _poll(self):
        if self.is_running() != self._last_running:
            self.update_state()
        return True

    def begin(self):
        if self.is_running():
            return
        script = self.config.get("nerd_dictation")
        if not script or not os.path.isfile(script):
            self.error("Can't find the nerd-dictation script.\nSet its location in Settings.")
            return
        # `--verbose=1` makes nerd-dictation report "Model loaded." once it's listening.
        cmd = [self.python, script, "begin", "--verbose=1", "--input=" + self.config["input"]]
        self.proc_engine = "Whisper" if self.config.get("whisper_enabled") else "VOSK"
        if self.config.get("whisper_enabled"):
            cmd += [
                "--engine=WHISPER",
                "--whisper-model=" + self.config["whisper_model"],
                "--whisper-device=" + self.config["whisper_device"],
                "--whisper-language=" + self.config["whisper_language"],
                "--whisper-pause={:.1f}".format(self.config["whisper_pause"]),
            ]
        else:
            model = self.config.get("model_dir")
            if model and os.path.isdir(model):
                cmd.append("--vosk-model-dir=" + model)
        words = self.config.get("ignore_words", "").strip()
        if self.config.get("ignore_words_enabled") and words:
            cmd.append("--ignore-words=" + words)
        if self.config.get("noise_suppression") and self.config["input"] == "PAREC":
            if noise_suppressed_source_ready():
                set_noise_suppressed_level(self.config["mic_level"])
                cmd.append("--pulse-device-name=" + NS_SOURCE)
            else:
                sys.stderr.write("Noise suppression unavailable, using the normal mic.\n")
        try:
            self.proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stderr=subprocess.PIPE)
        except OSError as ex:
            self.error("Could not start nerd-dictation:\n" + str(ex))
            return
        self.ready = False
        self._stderr_buf = b""
        self._stderr_tail = []
        GLib.io_add_watch(self.proc.stderr.fileno(), GLib.PRIORITY_DEFAULT,
                          GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self._on_stderr, self.proc.stderr)
        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, self.proc.pid, self._on_exit)
        self.update_state()

    def _on_stderr(self, fd, _condition, pipe):
        try:
            data = os.read(fd, 4096)
        except OSError:
            data = b""
        if not data:
            pipe.close()
            return False  # EOF: stop watching.
        self._stderr_buf += data
        *lines, self._stderr_buf = self._stderr_buf.split(b"\n")
        for line in lines:
            text = line.decode("utf-8", "replace").strip()
            if not text:
                continue
            self._stderr_tail = (self._stderr_tail + [text])[-10:]
            if text == "Model loaded." and not self.ready:
                self.ready = True
                self._play("sound_begin")
                self.update_state()
        return True

    def _play(self, key):
        if self.config.get("sounds"):
            play_sound(self.config.get(key))

    def _on_exit(self, _pid, status):
        proc, self.proc = self.proc, None
        if proc is not None:
            proc.wait()
            if proc.returncode not in (0, None, -signal.SIGTERM):
                details = "\n".join(self._stderr_tail) or "Run it from a terminal to see details."
                self.error("nerd-dictation exited with an error (code {:d}):\n\n{:s}".format(
                    proc.returncode, details))
        self.ready = False
        self.update_state()

    def end(self):
        if not self.is_running():
            return
        subprocess.call([self.python, self.config["nerd_dictation"], "end"])

    def toggle(self):
        if self.is_running():
            self.end()
        else:
            self.begin()

    # ---- Speech engine ----

    def _sync_engine_items(self):
        item = self.item_whisper if self.config.get("whisper_enabled") else self.item_vosk
        if not item.get_active():
            item.set_active(True)

    def _on_engine_toggled(self, _item):
        whisper = self.item_whisper.get_active()
        if whisper == bool(self.config.get("whisper_enabled")):
            return
        # Used from the next time dictation starts.
        self.config["whisper_enabled"] = whisper
        save_config(self.config)
        self.update_state()

    # ---- Shortcuts ----

    def unbind_shortcuts(self):
        for accel in self.bound:
            Keybinder.unbind(accel)
        self.bound = []

    def bind_shortcuts(self):
        self.unbind_shortcuts()
        failed = []
        for key, handler in (("shortcut_begin", self.begin), ("shortcut_end", self.end)):
            accel = self.config.get(key)
            if not accel:
                continue
            # Normalize so "<Super><Alt>d" and "<Alt><Super>d" count as the same key.
            keyval, mods = Gtk.accelerator_parse(accel)
            if keyval:
                accel = Gtk.accelerator_name(keyval, mods)
            if accel in self.bound:
                # Same key for both: make it a toggle.
                Keybinder.unbind(accel)
                self.bound.remove(accel)
                handler = self.toggle
            if Keybinder.bind(accel, lambda _keystr, h=handler: GLib.idle_add(h)):
                self.bound.append(accel)
            else:
                failed.append(accel_label(accel))
        if failed:
            self.error("Could not register shortcut(s): {:s}\n"
                       "They may already be used by another app.".format(", ".join(failed)))

    # ---- Settings / misc ----

    def open_settings(self):
        if self.settings_dialog is not None:
            self.settings_dialog.present()
            return
        dialog = SettingsDialog(self)
        self.settings_dialog = dialog
        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            self.config.update(dialog.collect())
            save_config(self.config)
            set_autostart(dialog.autostart_check.get_active())
            if not self.config["noise_suppression"] and not self.is_running():
                remove_noise_suppressed_source()
        else:
            # The level slider applies live, put back the saved level.
            set_noise_suppressed_level(self.config["mic_level"])
        dialog.destroy()
        self.settings_dialog = None
        self.bind_shortcuts()
        self._sync_engine_items()
        self.update_state()

    def error(self, message):
        dialog = Gtk.MessageDialog(
            message_type=Gtk.MessageType.ERROR, buttons=Gtk.ButtonsType.OK, text="Nerd Dictation")
        dialog.format_secondary_text(message)
        dialog.run()
        dialog.destroy()

    def quit(self):
        if self.is_running():
            self.end()
        self.unbind_shortcuts()
        remove_noise_suppressed_source()
        Gtk.main_quit()


def acquire_single_instance_lock():
    """Return a held lock file, or None if another tray app is already running."""
    import fcntl

    lock_dir = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    fh = open(os.path.join(lock_dir, APP_NAME + ".lock"), "w", encoding="utf-8")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fh.close()
        return None
    fh.write(str(os.getpid()))
    fh.flush()
    return fh


def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    # Held (not closed) for the life of the process; the OS releases it on exit.
    lock = acquire_single_instance_lock()
    if lock is None:
        sys.stderr.write("nerd-dictation-tray is already running.\n")
        sys.exit(0)
    if not os.path.exists(CONFIG_FILE):
        save_config(load_config())
    TrayApp()
    Gtk.main()


if __name__ == "__main__":
    main()
