# A PulseAudio virtual mic with WebRTC noise suppression, used only for dictation.
NS_SOURCE = "dictation_mic"
NS_SINK = "dictation_mic_ref"  # Unused echo-cancel reference sink the module requires.


def pactl(*args):
    try:
        return subprocess.run(["pactl", *args], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None


def noise_suppressed_source_ready():
    """Create the noise-suppressed mic if needed (on top of the default mic). Return True if usable."""
    sources = pactl("list", "sources", "short")
    if sources is None:
        return False
    if any(line.split("\t")[1:2] == [NS_SOURCE] for line in sources.stdout.splitlines()):
        return True
    master = pactl("get-default-source")
    if master is None or master.returncode != 0 or not master.stdout.strip():
        return False
    result = pactl(
        "load-module", "module-echo-cancel",
        "source_master=" + master.stdout.strip(),
        "source_name=" + NS_SOURCE,
        "sink_name=" + NS_SINK,
        "aec_method=webrtc",
        "source_properties=\"device.description='Dictation Mic (noise suppressed)'\"",
        "sink_properties=\"device.description='Dictation Mic reference'\"",
        # Auto-gain is off: it boosts quiet background noise back up.
        'aec_args="noise_suppression=1 high_pass_filter=1 analog_gain_control=0 digital_gain_control=0"',
    )
    return result is not None and result.returncode == 0


def set_noise_suppressed_level(percent):
    pactl("set-source-volume", NS_SOURCE, "{:d}%".format(int(percent)))


def remove_noise_suppressed_source():
    modules = pactl("list", "modules", "short")
    if modules is None:
        return
    for line in modules.stdout.splitlines():
        fields = line.split("\t")
        if len(fields) >= 3 and fields[1] == "module-echo-cancel" and "source_name=" + NS_SOURCE in fields[2]:
            pactl("unload-module", fields[0])


def play_sound(path):
    """Play a sound file without blocking, using whichever player is available."""
    if not path or not os.path.isfile(path):
        return
    for player in ("paplay", "pw-play", "canberra-gtk-play"):
        exe = shutil.which(player)
        if not exe:
            continue
        cmd = [exe, "-f", path] if player == "canberra-gtk-play" else [exe, path]
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            continue
        return


def load_config():
    config = dict(DEFAULT_CONFIG)
    try:
        with open(CONFIG_FILE, encoding="utf-8") as fh:
            config.update(json.load(fh))
    except (OSError, ValueError):
        pass
    return config


def save_config(config):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as fh:
        json.dump(config, fh, indent=2)


def autostart_enabled():
    return os.path.exists(AUTOSTART_FILE)


def set_autostart(enabled):
    if enabled:
        os.makedirs(os.path.dirname(AUTOSTART_FILE), exist_ok=True)
        with open(AUTOSTART_FILE, "w", encoding="utf-8") as fh:
            fh.write(
                "[Desktop Entry]\n"
                "Type=Application\n"
                "Name=Nerd Dictation\n"
                "Exec={:s}\n"
                "Icon=audio-input-microphone\n"
                "X-GNOME-Autostart-enabled=true\n".format(os.path.realpath(__file__))
            )
    elif os.path.exists(AUTOSTART_FILE):
        os.remove(AUTOSTART_FILE)


def accel_label(accel):
    if not accel:
        return "Not set"
    key, mods = Gtk.accelerator_parse(accel)
    return Gtk.accelerator_get_label(key, mods) if key else accel


class ShortcutButton(Gtk.Button):
    """A button that records a key combination when clicked."""

    def __init__(self, accel, on_capture_start, on_capture_end):
        super().__init__()
        self.accel = accel
        self._on_capture_start = on_capture_start
        self._on_capture_end = on_capture_end
        self._capturing = False
        self._handler = None
        self.set_label(accel_label(accel))
        self.connect("clicked", self._start_capture)

    def _start_capture(self, _button):
        if self._capturing:
            return
        self._capturing = True
        self._on_capture_start()
        self.set_label("Press keys… (Esc cancel, Backspace clear)")
        self._handler = self.get_toplevel().connect("key-press-event", self._on_key)

    def _finish(self):
        self._capturing = False
        self.get_toplevel().disconnect(self._handler)
        self.set_label(accel_label(self.accel))
        self._on_capture_end()

    def _on_key(self, _widget, event):
        keyval = Gdk.keyval_to_lower(event.keyval)
        mods = event.state & Gtk.accelerator_get_default_mod_mask()
        if keyval == Gdk.KEY_Escape and not mods:
            self._finish()
            return True
        if keyval == Gdk.KEY_BackSpace and not mods:
            self.accel = ""
            self._finish()
            return True
        # Ignore lone modifier presses, wait for the real key.
        if event.is_modifier:
            return True
        if not Gtk.accelerator_valid(keyval, mods):
            return True
        self.accel = Gtk.accelerator_name(keyval, mods)
        self._finish()
        return True


class SettingsDialog(Gtk.Dialog):
