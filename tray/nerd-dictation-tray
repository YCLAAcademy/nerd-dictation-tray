        reset = Gtk.Button(label="Reset to defaults")
        reset.set_tooltip_text("Fill in the default values. Nothing changes until you click Save.")
        reset.connect("clicked", lambda _b: self.load(DEFAULT_CONFIG))
        self.get_action_area().pack_start(reset, False, False, 0)
        self.get_action_area().set_child_secondary(reset, True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_button("Save", Gtk.ResponseType.OK)
        self.set_default_response(Gtk.ResponseType.OK)

        notebook = Gtk.Notebook(margin=8)
        self.get_content_area().add(notebook)
        notebook.append_page(self._page_general(), Gtk.Label(label="General"))
        notebook.append_page(self._page_engine(), Gtk.Label(label="Speech engine"))
        notebook.append_page(self._page_noise(), Gtk.Label(label="Noise"))
        notebook.append_page(self._page_sounds(), Gtk.Label(label="Sounds"))
        notebook.append_page(self._page_about(), Gtk.Label(label="About"))

